              12.0,
              197.6,
              130.89,
              239.27
            ],
            "text": "Mathematical \nFunction",
            "block_type": 0
          },
          {
            "bbox": [
              132.53,
              175.95,
              372.33,
              260.87
            ],
            "text": "Probability Mass Function \n(PMF): Gives the exact \nprobability of a specific value, \nP(X = x).",
            "block_type": 0
          },
          {
            "bbox": [
              396.22,
              175.95,
              703.31,
              260.87
            ],
            "text": "Probability Density Function (PDF): \nGives the density at a point; \nprobabilities are found by calculating \nthe area under the curve.",
            "block_type": 0
          },
          {
            "bbox": [
              132.53,
              287.48,
              382.7,
              329.15
            ],
            "text": "P(X = x) ≥ 0 (Can be a positive \nnumber)",
            "block_type": 0
          },
          {
            "bbox": [
              12.0,
              276.68,
              132.02,
              339.95
            ],
            "text": "Probability of \nan Exact \nValue",
            "block_type": 0
          },
          {
            "bbox": [
              396.22,
              265.88,
              687.86,
              350.75
            ],
            "text": "Always zero (P(X = x) = 0 because \nthere are infinitely many points). We \nonly measure probability over \nintervals, P(a ≤ X ≤ b).",
            "block_type": 0
          },
          {
            "bbox": [
              12.0,
              366.56,
              113.65,
              408.23
            ],
            "text": "Cumulative \nFunction",
            "block_type": 0
          },
          {
            "bbox": [
              132.53,
              355.76,
              384.17,
              419.03
            ],
            "text": "Cumulative Distribution \nFunction (CDF): Step function \nthat sums discrete probabilities.",
            "block_type": 0
          },
          {
            "bbox": [
              396.22,
              355.76,
              685.23,
              419.03
            ],
            "text": "Cumulative Distribution Function \n(CDF): Continuous, smooth curve \nrepresenting the integral of the PDF.",
